# ============================================
# 18Studio - Environment Configuration
# ============================================
# Salin file ini menjadi .env dan isi nilainya
# cp .env.example .env

# Server Configuration
PORT=3000

# URL Aplikasi (WAJIB diisi dengan domain Anda saat production!)
# Contoh: https://18studio.id atau https://booking.18studio.id
APP_URL=http://localhost:3000

# DOKU Payment Gateway
# Untuk production, ganti credential ke akun DOKU Production Anda
DOKU_CLIENT_ID=BRN-xxxx-xxxxxxxxxxxx
DOKU_SECRET_KEY=SK-xxxxxxxxxxxxxxxx
DOKU_IS_PRODUCTION=false

# Email (Gmail App Password)
# Buat App Password di: https://myaccount.google.com/apppasswords
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Kirimi.id WhatsApp Gateway
# Dapatkan kredensial ini dari dashboard kirimi.id Anda
KIRIMI_USER_CODE=your_user_code_here
KIRIMI_SECRET=your_secret_key_here
KIRIMI_DEVICE_ID=your_device_id_here

# Google Calendar Integration (Opsi A - Realtime Push API)
# Didapatkan dari Google Cloud Console -> Service Account Key (JSON)
# Pastikan kalender Anda telah membagikan akses edit (Make changes to events) ke service account email di bawah ini.
GOOGLE_SERVICE_ACCOUNT_EMAIL=lapanbelas-calendar@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_email@gmail.com

